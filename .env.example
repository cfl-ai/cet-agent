# 环境变量模板 —— 复制为 .env 后填写真实值
# 警告：请勿将真实密钥提交到版本库！.env 已在 .gitignore 中忽略

# 阿里云百炼（主LLM）
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_MODEL=qwen-turbo

# 智谱GLM（备LLM）
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash

# 即梦AI（文生图/视频） - 通过Docker本地部署
JIMENG_BASE_URL=http://localhost:3000
JIMENG_TOKEN=your_sessionid
